{
  "expo": {
    "name": "GC",
    "slug": "GC",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gc-logo.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.GC",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0912",
        "foregroundImage": "./assets/gc-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.anonymous.GC"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Let GC access your photos so you can send them to the group.",
          "cameraPermission": "Let GC use your camera so you can snap something for the group."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "eda4be96-0e54-4b02-88a8-d7a456652f83"
      }
    }
  }
}
